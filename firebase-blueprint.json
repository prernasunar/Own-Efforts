{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role designation (Field Worker or Manager)",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Worker or Manager full name",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Role of the user",
          "enum": ["Field Worker", "Manager"]
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created"
        }
      },
      "required": ["name", "role"]
    },
    "WorkType": {
      "title": "WorkType",
      "description": "Custom work items shared with the whole team",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the civil work item",
          "minLength": 1,
          "maxLength": 100
        },
        "uom": {
          "type": "string",
          "description": "Unit of measurement",
          "enum": ["meter", "Number"]
        },
        "createdBy": {
          "type": "string",
          "description": "Name of the worker who created this type",
          "maxLength": 100
        },
        "creatorUid": {
          "type": "string",
          "description": "Auth UID of the creator",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "uom"]
    },
    "WorkEntry": {
      "title": "WorkEntry",
      "description": "Daily site work entry logged by field workers",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID of the field worker",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Name of the field worker",
          "maxLength": 100
        },
        "workType": {
          "type": "string",
          "description": "Selected civil work item name",
          "maxLength": 100
        },
        "uom": {
          "type": "string",
          "description": "Unit of measurement",
          "enum": ["meter", "Number"]
        },
        "quantity": {
          "type": "number",
          "description": "Quantity completed"
        },
        "material": {
          "type": "string",
          "description": "Material used at site (e.g. HDPE Duct, Coupler, Concrete)",
          "maxLength": 500
        },
        "mou": {
          "type": "string",
          "description": "Measurement of Unit (Count or MTR)",
          "enum": ["Count", "MTR"]
        },
        "materials": {
          "type": "array",
          "description": "Multiple material items used at site (up to 30), each containing material name, mou (Count or MTR), and optional quantity",
          "maxItems": 30,
          "items": {
            "type": "object"
          }
        },
        "status": {
          "type": "string",
          "description": "Status of work entry (Rectify by us or Rectify by Genesis)",
          "enum": ["Rectify by us", "Rectify by Genesis", "Pending", "Done"]
        },
        "route": {
          "type": "string",
          "description": "Route, trench, line or section identifier",
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "description": "Work site address or location name",
          "maxLength": 300
        },
        "latLong": {
          "type": "string",
          "description": "Latitude and Longitude coordinates (e.g. Lat 19.053155° Long 73.016608°)",
          "maxLength": 200
        },
        "locationFrom": {
          "type": "string",
          "description": "Start location or GPS coordinate",
          "maxLength": 300
        },
        "locationTo": {
          "type": "string",
          "description": "End location or GPS coordinate",
          "maxLength": 300
        },
        "remark": {
          "type": "string",
          "description": "Optional site remark or notes",
          "maxLength": 1000
        },
        "photos": {
          "type": "array",
          "description": "Up to 4 site work photos (base64 compressed data URLs or URLs)",
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "description": "Editable work log date (YYYY-MM-DD)",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "userName", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile with role designation"
    },
    "/workTypes/{id}": {
      "schema": "WorkType",
      "description": "Custom work items added by team members"
    },
    "/entries/{entryId}": {
      "schema": "WorkEntry",
      "description": "Daily site work entries logged by field workers"
    }
  }
}
